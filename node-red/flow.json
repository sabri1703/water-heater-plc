{"id":"injSim2","type":"inject","z":"flowH2","name":"tank sim 1 s","props":[{"p":"payload"}],"repeat":"1","crontab":"","once":true,"onceDelay":"3","topic":"","payload":"","payloadType":"date","x":130,"y":200,"wires":[["fnSim2"]]},
{"id":"fnSim2","type":"function","z":"flowH2","name":"tank model + panel data","func":"let T = context.get('T');\nif (T === undefined) T = 22;\nconst c = flow.get('coils') || [];\nconst on = !!c[0] || !!flow.get('weld');\nT += 1.3 * (on ? 1 : 0) - 0.012 * (T - 20);\ncontext.set('T', T);\nlet L = flow.get('level');\nif (L === undefined) L = 78;\nconst raw = Math.max(0, Math.min(1023, Math.round(T * 1023 / 150)));\nconst wT = {payload:{fc:6, unitid:1, address:0, quantity:1, value:raw}};\nconst wL = {payload:{fc:6, unitid:1, address:1, quantity:1, value:Math.round(L * 1023 / 100)}};\nlet h = context.get('h') || [];\nh.push(T);\nif (h.length > 120) h.shift();\ncontext.set('h', h);\nconst arc = f => { f = Math.max(0, Math.min(1, f)); const a = Math.PI * (1 - f); return 'M20 100 A80 80 0 0 1 ' + (100 + 80 * Math.cos(a)).toFixed(1) + ' ' + (100 - 80 * Math.sin(a)).toFixed(1); };\nconst pts = h.map((v, i) => (30 + i * 570 / 119).toFixed(1) + ',' + (125 - Math.max(0, Math.min(120, v))).toFixed(1)).join(' ');\nconst tCol = T >= 90 ? '#e53935' : (T >= 70 ? '#fb8c00' : '#4caf50');\nconst lCol = L < 25 ? '#e53935' : (L < 30 ? '#fb8c00' : '#2196f3');\nconst ui = {payload:{T:T.toFixed(1), L:Math.round(L), tArc:arc(T / 120), lArc:arc(L / 100), tCol:tCol, lCol:lCol, pts:pts, run:!!c[6], heater:!!c[0], alarm:!!c[1], lvl:!!c[2]}};\nreturn [[wT, wL], ui];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":370,"y":200,"wires":[["wr2"],["hmi2"]]},

{"id":"hmi2","type":"ui_template","z":"flowH2","group":"grpH2","name":"HMI panel","order":1,"width":12,"height":0,"format":"<style>.hm{width:100%;font-family:inherit}.tp{display:flex;align-items:center;gap:6px}.tp svg{width:34%}.lp{flex:1;padding-left:8px}.lm{display:flex;align-items:center;padding:7px 0;font-size:15px}.lm b{margin-left:auto}.dot{width:14px;height:14px;border-radius:50%;background:#bbb;margin-right:10px;display:inline-block}.dot.on{background:#4caf50}.dot.ht{background:#fb8c00}.dot.bad{background:#e53935}.bt{display:flex;gap:8px;margin:6px 0}.bt button{flex:1;padding:12px 0;border:0;border-radius:3px;color:#fff;font-size:15px;font-weight:500;cursor:pointer}.cr{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:15px}.cr input[type=range]{flex:1}</style><div class='hm'><div class='tp'><svg viewBox='0 0 200 130'><path d='M20 100 A80 80 0 0 1 180 100' fill='none' stroke='#ccc' stroke-width='16'/><path ng-attr-d='{{msg.payload.tArc}}' fill='none' ng-attr-stroke='{{msg.payload.tCol}}' stroke-width='16'/><text x='100' y='98' text-anchor='middle' font-size='30' font-weight='bold'>{{msg.payload.T}}</text><text x='20' y='118' text-anchor='middle' font-size='11'>0</text><text x='180' y='118' text-anchor='middle' font-size='11'>120</text><text x='100' y='124' text-anchor='middle' font-size='14'>Temperature °C</text></svg><svg viewBox='0 0 200 130'><path d='M20 100 A80 80 0 0 1 180 100' fill='none' stroke='#ccc' stroke-width='16'/><path ng-attr-d='{{msg.payload.lArc}}' fill='none' ng-attr-stroke='{{msg.payload.lCol}}' stroke-width='16'/><text x='100' y='98' text-anchor='middle' font-size='30' font-weight='bold'>{{msg.payload.L}}</text><text x='20' y='118' text-anchor='middle' font-size='11'>0</text><text x='180' y='118' text-anchor='middle' font-size='11'>100</text><text x='100' y='124' text-anchor='middle' font-size='14'>Water level %</text></svg><div class='lp'><div class='lm'><span class='dot' ng-class='{on:msg.payload.run}'></span>Run<b>{{msg.payload.run?'ON':'OFF'}}</b></div><div class='lm'><span class='dot' ng-class='{ht:msg.payload.heater}'></span>Heater<b>{{msg.payload.heater?'ON':'OFF'}}</b></div><div class='lm'><span class='dot' ng-class='{bad:msg.payload.alarm}'></span>Over-temp<b>{{msg.payload.alarm?'ALARM':'OK'}}</b></div><div class='lm'><span class='dot' ng-class='{bad:msg.payload.lvl}'></span>Low water<b>{{msg.payload.lvl?'ALARM':'OK'}}</b></div></div></div><svg viewBox='0 0 600 140' style='width:100%'><rect width='600' height='140' fill='#fafafa'/><line x1='30' x2='600' y1='125' y2='125' stroke='#ddd'/><line x1='30' x2='600' y1='95' y2='95' stroke='#ddd'/><line x1='30' x2='600' y1='65' y2='65' stroke='#ddd'/><line x1='30' x2='600' y1='35' y2='35' stroke='#e53935' stroke-dasharray='6 4'/><rect x='30' y='62' width='570' height='6' fill='#2196f3' opacity='0.25'/><text x='26' y='129' text-anchor='end' font-size='11'>0</text><text x='26' y='99' text-anchor='end' font-size='11'>30</text><text x='26' y='69' text-anchor='end' font-size='11'>60</text><text x='26' y='39' text-anchor='end' font-size='11' fill='#e53935'>90</text><text x='596' y='30' text-anchor='end' font-size='11' fill='#e53935'>limit 90 °C</text><text x='34' y='14' font-size='12'>Temperature trend (last 2 min)</text><polyline ng-attr-points='{{msg.payload.pts}}' fill='none' stroke='#1f77b4' stroke-width='2'/></svg><div class='bt'><button style='background:#4caf50' ng-click='send({payload:3})'>START</button><button style='background:#e53935' ng-click='send({payload:4})'>STOP</button><button style='background:#fb8c00' ng-click='send({payload:5})'>RESET ALARM</button></div><div class='cr'><input type='checkbox' ng-model='wd' ng-change='send({payload:{weld:wd}})'> Relay stuck ON (fault test)</div><div class='cr'>Water level <input type='range' min='0' max='100' ng-init='lv=78' ng-model='lv' ng-change='send({payload:{level:lv}})'> <b>{{lv}} %</b></div></div>","storeOutMessages":true,"fwdInMessages":false,"resendOnRefresh":true,"templateScope":"local","className":"","x":620,"y":240,"wires":[["fnRoute2"]]},

{"id":"fnRoute2","type":"function","z":"flowH2","name":"route panel input","func":"const p = msg.payload;\nif (typeof p === 'number') { return msg; }\nif (p && p.level !== undefined) { flow.set('level', Number(p.level)); }\nif (p && p.weld !== undefined) { flow.set('weld', !!p.weld); }\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":340,"y":340,"wires":[["fnPulse2"]]},
{"id":"fnPulse2","type":"function","z":"flowH2","name":"400 ms pulse","func":"const a = msg.payload;\nnode.send({payload:{fc:5, unitid:1, address:a, quantity:1, value:true}});\nsetTimeout(() => node.send({payload:{fc:5, unitid:1, address:a, quantity:1, value:false}}), 400);\nreturn null;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":530,"y":340,"wires":[["wr2"]]},
